# Copy to .env on the server and replace example values. Never commit .env.
APP_DOMAIN=app.example.com
MINIO_DOMAIN=files.example.com

MYSQL_DATABASE=btl_csdl
MYSQL_USER=btl_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

MINIO_ROOT_USER=homebase_storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=homebase-avatars

JWT_SECRET=replace-with-a-generated-base64-secret
